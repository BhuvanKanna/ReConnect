{
  "name": "reconnect-relay",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are available on the Workers free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // e.g. "https://yourname.github.io" to stop other sites using your free quota. Empty = allow all.
    "ALLOWED_ORIGINS": "https://bhuvankanna.github.io"
  },
  "observability": { "enabled": true }
}
